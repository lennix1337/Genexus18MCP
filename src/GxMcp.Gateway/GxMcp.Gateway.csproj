<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>4.6.1</Version>
    <AssemblyVersion>4.6.1.0</AssemblyVersion>
    <FileVersion>4.6.1.0</FileVersion>
    <InformationalVersion>4.6.1</InformationalVersion>
    <!-- Workstation GC + ConserveMemory=9 + RetainVM=false keeps per-client Gateway
         footprint low (~1 heap/1 GC thread instead of per-core Server GC heaps/threads).
         HeapHardLimit (128 MB) bounds runaway retention while leaving headroom above
         SemanticCacheStore.DefaultMaxBytes (64 MB) and HardFrameCeilingBytes (16 MB). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="134217728" />
  </ItemGroup>

  <!-- PERFORMANCE (build flags): enable ReadyToRun for Release publish. This pre-compiles
       hot methods to native code at publish time, eliminating most JIT cost on cold start.
       Safe with reflection (GeneXus SDK is in the Worker, not here). Only kicks in for
       `dotnet publish -c Release`; debug builds are untouched. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <!-- The Release warning baseline is 0. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GxMcp.Gateway.Tests" />
    <InternalsVisibleTo Include="GxMcp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="10.0.5" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\GxMcp.Shared\JsonIngress.cs" Link="Shared\JsonIngress.cs" />
    <Compile Include="..\GxMcp.Shared\SharedHost\*.cs" LinkBase="Shared\SharedHost" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\gx-versions.json" Link="config\gx-versions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="..\..\config.sample.json" Link="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Update="tool_definitions.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <!-- Keep the official Nexa guidance available in packaged MCP resources.
         Only Markdown is embedded; the skill's scripts and JSON catalogs stay
         local reference assets and are never executed by the Gateway. -->
    <EmbeddedResource Include="..\..\.gemini\skills\nexa\SKILL.md">
      <LogicalName>GxMcp.Gateway.Nexa.SKILL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\.gemini\skills\nexa\references\*.md">
      <LogicalName>GxMcp.Gateway.Nexa.references.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
