<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- SearchRankParallelismBenchmark ports VectorService.CosineSimilarity (unsafe,
         unrolled dot product) verbatim so the measured per-item cost matches the worker. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GxMcp.Benchmarks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GxMcp.Gateway\GxMcp.Gateway.csproj" />
  </ItemGroup>
</Project>
