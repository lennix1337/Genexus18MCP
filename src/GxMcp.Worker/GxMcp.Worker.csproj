<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Version>4.3.1</Version>
    <AssemblyVersion>4.3.1.0</AssemblyVersion>
    <FileVersion>4.3.1.0</FileVersion>
    <InformationalVersion>4.3.1</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <GX_PATH Condition="'$(GX_PATH)' == ''">C:\Program Files (x86)\GeneXus\GeneXus18</GX_PATH>
    <GxMcpSdkManifest Condition="'$(GxMcpSdkManifest)' == '' and '$(GxMcpSdkProfile)' == 'evolution3'">$(MSBuildProjectDirectory)\..\..\config\sdk-compatibility.ev3.json</GxMcpSdkManifest>
    <GxMcpSdkManifest Condition="'$(GxMcpSdkManifest)' == ''">$(MSBuildProjectDirectory)\..\..\config\sdk-compatibility.json</GxMcpSdkManifest>
  </PropertyGroup>

  <!-- GeneXus X Evolution 3 (10.3) predates the module package manager (OPC), the
       Trial object cap and BuildOptions.FailIfReorg. Its Worker is built with
       -p:GxMcpSdkProfile=evolution3 and refuses those tools instead of calling them. -->
  <PropertyGroup Condition="'$(GxMcpSdkProfile)' == 'evolution3'">
    <DefineConstants>$(DefineConstants);GXMCP_SDK_EV3</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(GxMcpSdkProfile)' == 'evolution3'">
    <Compile Remove="Services\ModuleService.cs;Services\ModuleInstallSdkBackend.cs;Services\ModuleInstallPackage.cs;Services\ModuleInstallFlow.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(GxMcpSdkProfile)' != 'evolution3'">
    <Compile Remove="Services\Evolution3Unsupported.cs" />
  </ItemGroup>

  <Target Name="Evolution3LegacyRuntimePolicy" AfterTargets="Build" Condition="'$(GxMcpSdkProfile)' == 'evolution3'">
    <XmlPoke XmlInputPath="$(TargetDir)$(TargetFileName).config" Query="/configuration/startup/@useLegacyV2RuntimeActivationPolicy" Value="true" />
  </Target>

  <PropertyGroup Condition="'$(GxMcpSkipSdkValidation)' == ''">
    <GxMcpSkipSdkValidation>false</GxMcpSkipSdkValidation>
  </PropertyGroup>

  <Target Name="ValidateGeneXusSdk" BeforeTargets="ResolveAssemblyReferences" Condition="'$(GxMcpSkipSdkValidation)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\validate-gx-sdk.ps1&quot; -GxPath &quot;$(GX_PATH)&quot; -Manifest &quot;$(GxMcpSdkManifest)&quot;" />
  </Target>

  <ItemGroup>
    <None Include="$(GxMcpSdkManifest)" Link="sdk-compatibility.json" TargetPath="sdk-compatibility.json" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="..\..\config\events-u16-wwp16.2-audit.json" LogicalName="events-u16-wwp16.2-audit.json" />
    <None Include="..\..\config\events-u16-wwp16.2-audit.json" Link="events-u16-wwp16.2-audit.json" TargetPath="events-u16-wwp16.2-audit.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="..\..\config\events-u11-wwp16.1-audit.json" LogicalName="events-u11-wwp16.1-audit.json" />
    <None Include="..\..\config\events-u11-wwp16.1-audit.json" Link="events-u11-wwp16.1-audit.json" TargetPath="events-u11-wwp16.1-audit.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="..\..\config\events-u10-audit.json" LogicalName="events-u10-audit.json" />
    <None Include="..\..\config\events-u10-audit.json" Link="events-u10-audit.json" TargetPath="events-u10-audit.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('$(GX_PATH)\GeneXus.SecurityScanner.Common.dll')">
    <DefineConstants>$(DefineConstants);HAS_SECURITY_SCANNER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(GX_PATH)\GeneXus.TeamDevClient.Architecture.BL.dll')">
    <DefineConstants>$(DefineConstants);HAS_TEAMDEV_CI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WindowsBase" />
    <Reference Include="Artech.Packages.Patterns">
      <HintPath>$(GX_PATH)\Packages\Artech.Packages.Patterns.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <None Include="..\..\config\gx-versions.json" Link="config\gx-versions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <Reference Include="Artech.Architecture.Common">
      <HintPath>$(GX_PATH)\Artech.Architecture.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Framework" />
    <Reference Include="Microsoft.Build.Utilities.v4.0" />
    <Reference Include="Microsoft.Build.Utilities.Core" Condition="Exists('$(GX_PATH)\Microsoft.Build.Utilities.Core.dll')">
      <HintPath>$(GX_PATH)\Microsoft.Build.Utilities.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Genexus.Common">
      <HintPath>$(GX_PATH)\Artech.Genexus.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Udm.Framework">
      <HintPath>$(GX_PATH)\Artech.Udm.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Architecture.BL.Framework">
      <HintPath>$(GX_PATH)\Artech.Architecture.BL.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Architecture.Language">
      <HintPath>$(GX_PATH)\Artech.Architecture.Language.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Common.Language">
      <HintPath>$(GX_PATH)\Artech.Common.Language.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Architecture.Interfaces" Condition="'$(GxMcpSdkProfile)' != 'evolution3'">
      <HintPath>$(GX_PATH)\Artech.Architecture.Interfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Common.Properties">
      <HintPath>$(GX_PATH)\Artech.Common.Properties.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Common.Framework">
      <HintPath>$(GX_PATH)\Artech.Common.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Common.Helpers">
      <HintPath>$(GX_PATH)\Artech.Common.Helpers.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Common.Controls">
      <HintPath>$(GX_PATH)\Artech.Common.Controls.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Common">
      <HintPath>$(GX_PATH)\Artech.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Architecture.UI.Framework">
      <HintPath>$(GX_PATH)\Artech.Architecture.UI.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- genexus_gam: concrete IIntegratedSecurityService implementation lives in the GAM
         package assembly, not Artech.Architecture.Common. IIntegratedSecurityService itself
         doesn't implement IGxService, so it can't go through Services.TryGetService<T>()'s
         generic constraint directly — GamService resolves the concrete
         Artech.Packages.GAM.IntegratedSecurityService (which does implement IGxService) and
         casts to the interface. -->
    <Reference Include="Artech.Packages.GAM">
      <HintPath>$(GX_PATH)\Packages\Artech.Packages.GAM.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Team Development headless auth: TokenAuthorizationManager.GetToken + CommunicationData
         live here. The GeneXus Server uses OAuth; the UI.Framework login path that registers
         the session credential doesn't resolve headless, so we acquire the token directly. -->
    <Reference Include="Artech.Packages.TeamDevClient.BL">
      <HintPath>$(GX_PATH)\Packages\Artech.Packages.TeamDevClient.BL.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- genexus_security action=scan_native: the native GeneXus Security Scanner
         (ISecurityScannerService.Scan) + its query/plan/output types. -->
    <Reference Include="GeneXus.SecurityScanner.Common" Condition="Exists('$(GX_PATH)\GeneXus.SecurityScanner.Common.dll')">
      <HintPath>$(GX_PATH)\GeneXus.SecurityScanner.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- genexus_gxserver action=pipeline_*: IContinuousIntegrationService (CI pipelines). -->
    <Reference Include="GeneXus.TeamDevClient.Architecture.BL" Condition="Exists('$(GX_PATH)\GeneXus.TeamDevClient.Architecture.BL.dll')">
      <HintPath>$(GX_PATH)\GeneXus.TeamDevClient.Architecture.BL.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Concrete service impls not registered in the headless worker's service registry
         (IDE-package services). We construct them directly (public parameterless ctors) and
         cast to the interface — same idiom as GamService. GenexusBL: ModelInformationService,
         DeploymentTargetService, DeployService. Specifier: SpecifierService. -->
    <Reference Include="Artech.Packages.GenexusBL">
      <HintPath>$(GX_PATH)\Packages\Artech.Packages.GenexusBL.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Artech.Packages.Specifier">
      <HintPath>$(GX_PATH)\Packages\Artech.Packages.Specifier.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\GxMcp.Shared\JsonIngress.cs" Link="Shared\JsonIngress.cs" />
    <Compile Include="..\GxMcp.Shared\SharedHost\*.cs" LinkBase="Shared\SharedHost" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Playbooks\*.md" />
  </ItemGroup>
</Project>
