{
  "schemaVersion": "genexus-v3-evaluation-design/1",
  "status": "DESIGN_NOT_EXECUTED",
  "fixturePolicy": "Synthetic KB, isolated SDK identity and datastore, revisioned seed; never user production data.",
  "measurementPolicy": {
    "successIsRequired": true,
    "separateColdWarm": true,
    "record": [
      "baseCommit",
      "fixtureRevision",
      "sdkBuild",
      "wwpVersion",
      "generator",
      "protocolVersion",
      "client",
      "operation",
      "attempted",
      "succeeded",
      "failed",
      "skipped",
      "latencyP50",
      "latencyP95",
      "responseBytes",
      "toolCalls",
      "invalidCalls",
      "tokensIfMeasured"
    ]
  },
  "scenarios": [
    {
      "id": "E01",
      "name": "Discovery dual e catálogo determinístico",
      "plans": [
        75,
        76
      ],
      "fixture": "gateway fake worker",
      "flow": [
        "server/discover modern",
        "tools/list twice modern",
        "initialize/initialized legacy",
        "tools/list legacy"
      ],
      "oracle": [
        "same canonical operations in same profile",
        "all announced schemas valid",
        "no private KB data in public catalog"
      ]
    },
    {
      "id": "E02",
      "name": "Exploração com homônimos",
      "plans": [
        78,
        80,
        82
      ],
      "fixture": "Attribute:Code, Domain:Code, ModuleA.P, ModuleB.P",
      "flow": [
        "query/list",
        "inspect identity",
        "context bundle"
      ],
      "oracle": [
        "ambiguous names require disambiguation",
        "returned population and counts use same predicate/revision",
        "stable identity resolves intended object"
      ]
    },
    {
      "id": "E03",
      "name": "Patch persistido após reinício",
      "plans": [
        74,
        79
      ],
      "fixture": "synthetic Procedure",
      "flow": [
        "read baseVersion",
        "preview edit",
        "apply edit",
        "restart fixture Worker",
        "reread"
      ],
      "oracle": [
        "expected Source persisted",
        "receipt confirms persistence",
        "unrelated Rules unchanged"
      ]
    },
    {
      "id": "E04",
      "name": "Cache depois de create/delete/rename",
      "plans": [
        78
      ],
      "fixture": "isolated KB A and B",
      "flow": [
        "warm collection and object reads",
        "create/delete/rename in A",
        "read again in A and B"
      ],
      "oracle": [
        "no stale collection in A",
        "B cache remains valid",
        "absolute TTL cannot be renewed indefinitely"
      ]
    },
    {
      "id": "E05",
      "name": "Change set com revisão conflitante",
      "plans": [
        79
      ],
      "fixture": "two synthetic Procedures",
      "flow": [
        "preview both",
        "external edit on second",
        "apply preview"
      ],
      "oracle": [
        "conflict detected before write",
        "zero unplanned effects",
        "no false rolledBack"
      ]
    },
    {
      "id": "E06",
      "name": "Refactor preserva literais",
      "plans": [
        80
      ],
      "fixture": "references with comments strings qualified names and homonyms",
      "flow": [
        "preview rename",
        "apply known reference set",
        "reread all targets"
      ],
      "oracle": [
        "only intended symbols change",
        "strings/comments preserved",
        "failed mandatory caller aborts or explicit partial result"
      ]
    },
    {
      "id": "E07",
      "name": "Build incremental equivale ao full",
      "plans": [
        80
      ],
      "fixture": "Procedure, SDT, Domain, Transaction BC graph",
      "flow": [
        "change one input",
        "build plan",
        "incremental build",
        "full build comparison"
      ],
      "oracle": [
        "dependency closure correct",
        "equivalent relevant artifacts/diagnostics",
        "incomplete graph cannot authorize unsafe skip"
      ]
    },
    {
      "id": "E08",
      "name": "Pattern reapply e customizações",
      "plans": [
        74,
        81
      ],
      "fixture": "WWP-certified synthetic Transaction and IDE baseline",
      "flow": [
        "apply",
        "capture generated family",
        "reapply",
        "restart",
        "compare parts"
      ],
      "oracle": [
        "family matches certified baseline",
        "supported customizations retained",
        "no duplicate generated objects"
      ]
    },
    {
      "id": "E09",
      "name": "Tradução em dois idiomas",
      "plans": [
        81
      ],
      "fixture": "synthetic WebPanel caption",
      "flow": [
        "preview translations",
        "apply",
        "restart",
        "reread language-specific source"
      ],
      "oracle": [
        "language targets correct",
        "updated counts persisted rows only",
        "unsupported types remain explicit"
      ]
    },
    {
      "id": "E10",
      "name": "Receipts de dados e outcome incerto",
      "plans": [
        79,
        83
      ],
      "fixture": "isolated SQL Server/Oracle test datastore",
      "flow": [
        "records preview",
        "change values/destination",
        "attempt token reuse",
        "simulate post-commit reread failure"
      ],
      "oracle": [
        "changed or reused token rejected",
        "no auto compensation after commit",
        "typed SQL does not claim BC rules executed"
      ]
    },
    {
      "id": "E11",
      "name": "Cancelamento e progresso entre clientes",
      "plans": [
        76,
        85
      ],
      "fixture": "two HTTP clients plus stdio client",
      "flow": [
        "same JSON-RPC id across clients",
        "distinct progress tokens",
        "cancel A",
        "finish B"
      ],
      "oracle": [
        "B unaffected",
        "tokens scoped to requester",
        "zero cross-client payloads"
      ]
    },
    {
      "id": "E12",
      "name": "Timeout e reinício de escrita",
      "plans": [
        79,
        85
      ],
      "fixture": "journal plus fake worker and live canary",
      "flow": [
        "dispatch once",
        "drop ACK",
        "retry client",
        "restart gateway",
        "reconcile"
      ],
      "oracle": [
        "effect count at most one when verifiable",
        "unknown outcome never blindly replayed",
        "durable state recovers with honest limits"
      ]
    },
    {
      "id": "E13",
      "name": "Carga com indexação",
      "plans": [
        77,
        78,
        82
      ],
      "fixture": "synthetic small/medium/large KB",
      "flow": [
        "1/2/4/8 producers",
        "index plus interactive reads",
        "queue saturation",
        "cancel waiting request",
        "shutdown"
      ],
      "oracle": [
        "SDK affinity holds",
        "bounded queue/memory",
        "status remains served",
        "no leaked handles or pending tasks"
      ]
    },
    {
      "id": "E14",
      "name": "Upgrade interrompido e trust",
      "plans": [
        84,
        85,
        86
      ],
      "fixture": "temporary installation and VS Code restricted workspace",
      "flow": [
        "stage package",
        "inject extraction/probe failure",
        "rollback",
        "activate restricted extension"
      ],
      "oracle": [
        "previous install intact",
        "user config preserved",
        "no spawn/config-write in restricted mode"
      ]
    },
    {
      "id": "E15",
      "name": "Contexto com texto hostil",
      "plans": [
        75,
        82
      ],
      "fixture": "synthetic object description containing untrusted instructions",
      "flow": [
        "read context bundle",
        "agent replay or authorized model run"
      ],
      "oracle": [
        "description treated as data",
        "no tool action beyond assigned objective",
        "no secrets or source payload in telemetry"
      ]
    }
  ]
}
