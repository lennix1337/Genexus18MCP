# --- Build Artifacts ---
/bin/
/obj/
/publish/
[Bb]in/
[Oo]bj/

# --- Runtime Data ---
*.log
*.txt
*.bak
!LICENSE.txt
# Engine test fixtures are text files that the tests read: keep them visible to git.
!src/gx-engine/tests/fixtures/**/*.txt
# gx-engine web templates embedded with include_str!: the build fails without them.
!src/gx-engine/src/csharp/webform/*.txt
*.zip
publish.zip.sha256
*.xpz
/artifacts/
BenchmarkDotNet.Artifacts/
# dotnet test result files carry the machine name and are ~1 MB each.
TestResults/
*.trx
.history/
batch_buffer/
/cache/
!src/gxwire/src/cache/
.gx_mirror/
.tmp/
.test-bin/
.codex/

# Session MCP probe outputs (not source).
/drafts.json
/env.json
/hits.json
/p12docs.json

# --- IDE & OS ---
.vscode/
.idea/
*.suo
*.user
*.userprefs

# --- Node.js / VS Code Extension ---
node_modules/
out/
.vscode-test/
*.vsix

/tasks

# --- Extension Backend Deployment ---
/src/nexus-ide/backend/

# --- Local config (use config.sample.json as template) ---
/config.json

# --- Scratch / debug artifacts ---
scripts/_*
scratchpad/
worktrees/

# --- Claude Code session state (per-user, not source) ---
.claude/

# --- Local user / IDE state (not source) ---
.gemini/settings.json
install.cmd
scripts/research/
scratch/

# F17 — SDK surface probe artifacts. raw.json is ~17MB and changes per GeneXus version.
# Track INDEX.md / generators.md / wwp-projection-discovery.md / README.md instead.
docs/sdk-probe/raw.json

# Smoke-test logs (generated by scripts/smoke-live-*.ps1)
.gx-smoke-logs*/
.gx-smoke-paced/

.gx-smoke-final/
.gx-smoke*/

# Local agent tooling stays ignored; the project artifact-comparison skill is source.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/gxe-artifact-parity/
skills-lock.json
.freebuff/

/.commandcode/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class

# OpenCode local goal state
.opencode/
